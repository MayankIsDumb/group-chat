{
	"schemaVersion": 1,
	"id": "groupchat",
	"version": "${version}",
	"name": "Group Chat",
	"description": "Discord-style group chats inside Minecraft: groups, invites, images, stickers and voice calls.",
	"authors": [
		"Mayank"
	],
	"license": "MIT",
	"icon": "assets/groupchat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.groupchat.GroupChat"
		],
		"client": [
			"com.example.groupchat.client.GroupChatClient"
		],
		"modmenu": [
			"com.example.groupchat.client.ModMenuIntegration"
		],
		"voicechat": [
			"com.example.groupchat.voice.SvcPlugin"
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"contributors": [
		"Afkz Studio"
	]
}
